<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{{ page_title }}</title>
    {{ content_for_header }}
    {{ 'storefront.css' | asset_url | stylesheet_tag }}
  </head>
  <body class="pari-storefront">
    <div id="header-group">
      {% sections 'header-group' %}
    </div>

    <main id="MainContent">
      {{ content_for_layout }}
    </main>

    <div id="footer-group">
      {% sections 'footer-group' %}
    </div>

    <script src="{{ 'storefront.js' | asset_url }}" defer></script>
  </body>
</html>
